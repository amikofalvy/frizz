@@ -0,0 +1,57 @@
+import { useContext, useRef, useState } from "react"
+import type { RegisteredQuestionView, ThreadView } from "@frizz/shared"
+import { RegisteredAnsweringContext } from "./RegisteredQuestionCards.tsx"
+import { PhoneDoneButton } from "./PhoneDoneButton.tsx"
+import { phoneRecommendation } from "../lib/phoneRecommendation.ts"
+import { PhoneReviewContext } from "../lib/phoneReviewContext.ts"
+import { leaveFiledThread, nextThreadNeedingYou } from "../lib/mobileTriage.ts"
+import { store } from "../store.ts"
+
+export function PhoneRecommendationBar({ thread, questions, onAnswer, onReply }: {
+  thread: ThreadView; questions: readonly RegisteredQuestionView[]; onAnswer: () => void; onReply: () => void
+}) {
+  const answering = useContext(RegisteredAnsweringContext)!
+  const review = useContext(PhoneReviewContext)!
+  const pending = useRef(false)
+  const [sending, setSending] = useState(false)
+  const hasDraft = questions.some((q) => [...answering.answersOf(q).values()].some((a) => a.text.trim() || a.chosen !== null || a.chosenSet?.length))
+  const recommendation = phoneRecommendation(thread, questions, hasDraft)
+  const accept = async () => {
+    if (pending.current || review.busy) return
+    // Capture the successor before optimistic answering removes this thread from the queue.
+    const next = nextThreadNeedingYou(store.board?.threads ?? [], thread.id)
+    pending.current = true
+    setSending(true)
+    review.setBusy(true)
+    try {
+      if (await answering.submitRecommended(questions)) {
+        const current = store.drawers.findLast((d) => !d.closing && d.kind === "thread")
+        if (current?.slug === thread.id) leaveFiledThread(thread.id, next)
+      }
+    } finally { pending.current = false; setSending(false); review.setBusy(false) }
+  }
+  const summary = recommendation.kind === "answers" ? recommendation.labels.join(" · ")
+    : recommendation.kind === "done" ? "Mark as done" : recommendation.reason
+  return (
+    <div data-phone-recommendation className="flex min-w-0 flex-1 flex-col gap-2">
+      <div className="text-[13px] leading-[18px]">
+        <div className="text-[11px] font-medium text-muted">{recommendation.kind === "review" ? "Review" : "Recommendation"}</div>
+        <div data-phone-recommendation-summary className="max-h-[54px] overflow-y-auto break-words text-fg">{summary}</div>
+      </div>
+      <div className="flex items-center gap-2">
+        <button type="button" data-phone-answer-reply onClick={onReply} disabled={review.busy}
+          className="min-h-[44px] shrink-0 rounded-full border border-border-strong px-3 text-[13px] text-muted disabled:opacity-45">Reply</button>
+        {recommendation.kind === "done" ? <PhoneDoneButton thread={thread} compact={false} disabled={review.busy} label="Mark as done" />
+          : <button type="button" data-phone-accept={recommendation.kind === "answers" || undefined} data-phone-answer-open={recommendation.kind === "review" || undefined}
+              onClick={recommendation.kind === "answers" ? () => void accept() : questions.length ? onAnswer : onReply}
+              disabled={review.busy || answering.sending}
+              className="min-h-[44px] min-w-0 flex-1 rounded-full bg-fg px-3 text-[14px] font-semibold text-bg disabled:opacity-45">
+              {sending ? "Sending…" : recommendation.kind === "answers" ? "Accept & send" : questions.length ? "Answer" : "Write a reply"}
+            </button>}
+        {recommendation.kind === "answers" && <button type="button" data-phone-answer-open onClick={onAnswer} disabled={review.busy}
+          className="min-h-[44px] shrink-0 px-1 text-[13px] text-muted disabled:opacity-45">Edit</button>}
+      </div>
+      {answering.error && <div role="alert" className="text-[12px] text-error">{answering.error}</div>}
+    </div>
+  )
+}
diff --git a/packages/web/src/components/PhoneReviewDeck.tsx b/packages/web/src/components/PhoneReviewDeck.tsx
new file mode 100644
index 00000000..4705de5c
--- /dev/null
+++ b/packages/web/src/components/PhoneReviewDeck.tsx
@@ -0,0 +1,116 @@
+import { useEffect, useRef, useState } from "react"
+import { useSnapshot } from "valtio"
+import { asThreads, useBoard } from "../hooks.ts"
+import { queued } from "../groups.ts"
+import { prefs } from "../lib/prefs.ts"
+import { phoneQueue } from "../lib/mobileTriage.ts"
+import { replaceQueueThread } from "../lib/router.ts"
+import { PhoneReviewContext } from "../lib/phoneReviewContext.ts"
+import { useOptimisticallyArchived } from "../lib/optimisticArchive.ts"
+import { useOptimisticallySteered } from "../lib/steering.ts"
+import { ThreadView } from "./ChatView.tsx"
+
+// Only three real conversation surfaces are observed. Neighbors are mounted (and inert), not
+// constructed on release; promoting one preserves its DOM, measured rows and scroll position.
+export function PhoneReviewDeck({ slug, onClose }: { slug: string; onClose: () => void }) {
+  const board = useBoard()
+  const { queueOrder, queueSort } = useSnapshot(prefs)
+  const all = useOptimisticallyArchived(useOptimisticallySteered(asThreads(board?.threads ?? [])))
+  const ids = phoneQueue(all, queueOrder, queueSort).filter(queued).map((t) => t.id)
+  const index = ids.indexOf(slug)
+  const neighbors = useRef<{ slug: string; previous?: string; next?: string }>({ slug })
+  if (index >= 0) neighbors.current = { slug, previous: ids[index - 1], next: ids[index + 1] }
+  else if (neighbors.current.slug !== slug) neighbors.current = { slug }
+  const { previous, next } = neighbors.current
+  const panels = [previous, slug, next].filter((id): id is string => !!id)
+  const [dock, setDock] = useState<HTMLDivElement | null>(null)
+  const [under, setUnder] = useState<string | undefined>(next)
+  const [busy, setBusy] = useState(false)
+  const root = useRef<HTMLDivElement>(null)
+  const cards = useRef(new Map<string, HTMLDivElement>())
+  const gesture = useRef<{ x: number; y: number; horizontal: boolean; target?: string } | null>(null)
+  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined)
+  useEffect(() => () => clearTimeout(timer.current), [])
+  useEffect(() => {
+    clearTimeout(timer.current)
+    gesture.current = null
+    setBusy(false)
+    setUnder(next)
+    for (const el of cards.current.values()) { el.style.transition = "none"; el.style.transform = "none" }
+  }, [slug])
+
+  useEffect(() => {
+    const el = root.current
+    if (!el) return
+    const reset = () => {
+      const card = cards.current.get(slug)
+      if (card) { card.style.transition = "transform 240ms ease-out"; card.style.transform = "none" }
+      gesture.current = null
+    }
+    const start = (event: TouchEvent) => {
+      if (busy || event.touches.length !== 1 || document.getSelection()?.toString()) return
+      const target = event.target as Element
+      // Leave controls, code panning, selection and the OS edge/back gesture alone.
+      if (target.closest("button,a,input,textarea,select,pre,[contenteditable=true],[role=button]")) return
+      const p = event.touches[0]!
+      if (p.clientX < 24 || p.clientX > innerWidth - 24) return
+      gesture.current = { x: p.clientX, y: p.clientY, horizontal: false }
+    }
+    const move = (event: TouchEvent) => {
+      const g = gesture.current
+      if (!g) return
+      if (event.touches.length !== 1) { reset(); return }
+      const p = event.touches[0]!, dx = p.clientX - g.x, dy = p.clientY - g.y
+      if (!g.horizontal) {
+        if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx) * 1.2) { gesture.current = null; return }
+        if (Math.abs(dx) < 10 || Math.abs(dx) < Math.abs(dy) * 1.2) return
+        g.horizontal = true
+      }
+      event.preventDefault()
+      const neighbor = dx < 0 ? next : previous
+      g.target = neighbor && cards.current.get(neighbor)?.querySelector('[data-drawer-scroll-ready="true"]') ? neighbor : undefined
+      setUnder(g.target)
+      const card = cards.current.get(slug)
+      if (!card) return
+      const x = g.target ? dx : dx * .25, f = x / el.clientWidth
+      card.style.transition = "none"
+      card.style.transform = matchMedia("(prefers-reduced-motion:reduce)").matches ? `translateX(${x * .85}px)`
+        : `translate(${x * .85}px,${-Math.min(16, f * f * 35)}px) rotate(${Math.max(-8, Math.min(8, f * 11))}deg)`
+    }
+    const end = (event: TouchEvent) => {
+      const g = gesture.current
+      if (!g) return
+      const dx = event.changedTouches[0]!.clientX - g.x
+      if (!g.horizontal || Math.abs(dx) < 65 || !g.target || !ids.includes(g.target)) { reset(); return }
+      const target = g.target
+      gesture.current = null
+      setBusy(true)
+      const card = cards.current.get(slug)
+      const ms = matchMedia("(prefers-reduced-motion:reduce)").matches ? 0 : 260
+      if (card) { card.style.transition = `transform ${ms}ms ease-in`; card.style.transform = `translateX(${Math.sign(dx) * (el.clientWidth + 120)}px) rotate(${ms ? Math.sign(dx) * 14 : 0}deg)` }
+      timer.current = setTimeout(() => { replaceQueueThread(target) }, ms)
+    }
+    el.addEventListener("touchstart", start, { passive: true })
+    el.addEventListener("touchmove", move, { passive: false })
+    el.addEventListener("touchend", end, { passive: true })
+    el.addEventListener("touchcancel", reset)
+    return () => { el.removeEventListener("touchstart", start); el.removeEventListener("touchmove", move); el.removeEventListener("touchend", end); el.removeEventListener("touchcancel", reset) }
+  }, [slug, previous, next, busy, ids.join(" ")])
+
+  return (
+    <div data-phone-review-deck className="flex min-h-0 flex-1 flex-col bg-bg">
+      <div ref={root} data-phone-review-stage className="relative min-h-0 flex-1 overflow-hidden">
+        {panels.map((id) => (
+          <div key={id} ref={(el) => { if (el) cards.current.set(id, el); else cards.current.delete(id) }}
+            data-phone-review-card={id} data-phone-review-current={id === slug} inert={id !== slug} aria-hidden={id !== slug || undefined}
+            className={`absolute inset-0 flex min-h-0 flex-col bg-panel [transform-origin:50%_80%] ${id === slug ? "z-[3]" : id === under ? "z-[2]" : "invisible z-[1]"}`}>
+            <PhoneReviewContext.Provider value={{ active: id === slug, dock, busy, setBusy }}>
+              <ThreadView slug={id} onClose={onClose} virtualized />
+            </PhoneReviewContext.Provider>
+          </div>
+        ))}
+      </div>
+      <div ref={setDock} data-phone-review-dock className="relative z-10 shrink-0 bg-panel" />
+    </div>
+  )
+}
