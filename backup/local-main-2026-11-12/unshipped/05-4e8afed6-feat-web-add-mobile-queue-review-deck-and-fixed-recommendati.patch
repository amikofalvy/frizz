+import { test } from "node:test"
+import assert from "node:assert/strict"
+import type { RegisteredQuestionView, ThreadView } from "@frizz/shared"
+import { phoneRecommendation } from "./phoneRecommendation.ts"
+
+const thread = (extra: Partial<ThreadView> = {}) => ({ id: "review", kind: "session", state: "open", runtime: "turn-idle", needsYou: true, subAgents: [], bgShells: [], ...extra } as ThreadView)
+const done = thread({ lastFence: { kind: "done", body: "Landed" } as ThreadView["lastFence"] })
+const question = (extra: Partial<RegisteredQuestionView["spec"]> = {}): RegisteredQuestionView => ({
+  id: "qst_test", askedAt: "2026-10-09T10:00:00Z", spec: { question: "Which lifetime?", kind: "question", options: [{ label: "Short", recommended: true }, { label: "Long" }], ...extra },
+})
+
+test("explicit complete handoff recommends Done, not merely an idle thread", () => {
+  assert.equal(phoneRecommendation(done, []).kind, "done")
+  assert.equal(phoneRecommendation(thread(), []).kind, "review")
+  assert.equal(phoneRecommendation(done, [], true).kind, "review")
+  assert.equal(phoneRecommendation({ ...done, runtime: "running" }, []).kind, "review")
+  assert.equal(phoneRecommendation({ ...done, pendingInteraction: true }, []).kind, "review")
+})
+test("questions outrank completion and build exact canonical answers as one batch", () => {
+  const q = question(), second = { ...question(), id: "qst_second" }
+  assert.deepEqual(phoneRecommendation(done, [q, second]), { kind: "answers", labels: ["Short", "Short"], answers: [q, second].map((q) => ({ questionId: q.id, question: q.spec.question, chosen: ["Short"] })) })
+})
+test("unsafe, missing, ambiguous, edited and branching choices stay manual; no partial batch", () => {
+  for (const spec of [
+    { options: [] }, { options: [{ label: "Short" }] },
+    { options: [{ label: "Short", recommended: true }, { label: "Long", recommended: true }] },
+    { kind: "multi" as const }, { secret: true }, { danger: true },
+    { options: [{ label: "Short", recommended: true, followUps: [{ question: "Which value?", kind: "question" as const }] }] },
+  ]) assert.equal(phoneRecommendation(done, [question(), question(spec)]).kind, "review", JSON.stringify(spec))
+  assert.equal(phoneRecommendation(done, [question()], true).kind, "review")
+})
diff --git a/packages/web/src/lib/phoneRecommendation.ts b/packages/web/src/lib/phoneRecommendation.ts
new file mode 100644
index 00000000..9135cd48
--- /dev/null
+++ b/packages/web/src/lib/phoneRecommendation.ts
@@ -0,0 +1,29 @@
+import type { QuestionAnswer, RegisteredQuestionView, ThreadView } from "@frizz/shared"
+import { sessionIndicatorKind } from "../groups.ts"
+
+export type PhoneRecommendation =
+  | { kind: "answers"; labels: string[]; answers: QuestionAnswer[] }
+  | { kind: "done" }
+  | { kind: "review"; reason: string }
+
+// A recommendation is an explicit choice, not a guessed yes. Branches, secrets, destructive
+// questions and existing edits belong to the answer sheet; never send a partial batch.
+export function phoneRecommendation(thread: ThreadView, questions: readonly RegisteredQuestionView[], hasDraft = false): PhoneRecommendation {
+  if (thread.pendingAsk || thread.pendingQuestion || thread.pendingInteraction) return { kind: "review", reason: "Review the pending request" }
+  if (questions.length) {
+    if (hasDraft) return { kind: "review", reason: "Review the answers already started" }
+    const answers: QuestionAnswer[] = [], labels: string[] = []
+    for (const q of questions) {
+      const options = q.spec.options ?? []
+      const recommended = options.filter((o) => o.recommended)
+      if (q.spec.secret || q.spec.danger || q.spec.kind !== "question" || recommended.length !== 1 || recommended[0]!.followUps?.length) {
+        return { kind: "review", reason: "Answer the open questions" }
+      }
+      labels.push(recommended[0]!.label)
+      answers.push({ questionId: q.id, question: q.spec.question, chosen: [recommended[0]!.label] })
+    }
+    return { kind: "answers", labels, answers }
+  }
+  if (!hasDraft && sessionIndicatorKind(thread) === "done") return { kind: "done" }
+  return { kind: "review", reason: hasDraft ? "Continue the reply already started" : "Review the handoff" }
+}
