diff --git a/packages/web/src/groups.ts b/packages/web/src/groups.ts
index 84d270e7..12e3215c 100644
--- a/packages/web/src/groups.ts
+++ b/packages/web/src/groups.ts
@@ -211,8 +211,8 @@ export function orderByInteraction(threads: readonly ThreadView[]): ThreadView[]
 // lastActiveAt keys off when an AT-REST thread came to rest (matching its "Last active" label) and off
 // the stable user-interaction time for a running row, so agent tool churn never reorders a card.
 // id-tiebroken for a stable order among equal-age rows.
-// The operator can now explicitly group by icon or put checked handoffs first. Within each group,
-// the selected time direction and id tie-break still apply; neither property changes queue membership.
+// The operator can explicitly sort by icon or checked handoff. Direction reverses both the selected
+// property and its time tie-break; neither property changes queue membership.
 export function orderQueue(threads: readonly ThreadView[], direction: QueueDirection = "fifo", sort: QueueSort = "time"): ThreadView[] {
   const dir = direction === "lifo" ? -1 : 1
   return [...threads].sort((a, b) => {
@@ -220,7 +220,7 @@ export function orderQueue(threads: readonly ThreadView[], direction: QueueDirec
     const bk = sessionIndicatorKind(b)
     const group = sort === "state" ? STATE_ORDER[ak] - STATE_ORDER[bk]
       : sort === "done" ? Number(bk === "done") - Number(ak === "done") : 0
-    if (group !== 0) return group
+    if (group !== 0) return group * dir
     const age = (lastActiveAt(a) - lastActiveAt(b)) * dir
     return age !== 0 ? age : a.id.localeCompare(b.id)
   })
diff --git a/packages/web/src/lib/mobileTriage.test.ts b/packages/web/src/lib/mobileTriage.test.ts
