@@ -4,7 +4,7 @@ import type { ThreadView } from "@frizz/shared"
 import { nextThreadNeedingYou, phoneQueue } from "./mobileTriage.ts"
 
 // Rows the way the board sends them. `needsYou` is the server's queue bit (a queue card); an ask also
-// carries `pendingAsk`, which is what needsAction — and so the phone's asks-first order — keys on.
+// carries `pendingAsk`. The phone follows the selected sort, without a hidden asks-first band.
 const row = (id: string, over: Partial<ThreadView> = {}) => ({
   id,
   kind: "session",
@@ -58,3 +58,18 @@ test("explicit done-first sort overrides the phone's asks-first order", () => {
   assert.deepEqual(phoneQueue(threads, "fifo", "done").map((t) => t.id), ["done", "ask", "rest"])
   assert.equal(nextThreadNeedingYou(threads, "done", "fifo", {}, "done")?.id, "ask")
 })
+
+test("Done follows the reversed property sort, not its default direction", () => {
+  const first = rested("first", "2026-09-30T07:00:00.000Z")
+  const middle = rested("middle", "2026-09-30T08:00:00.000Z")
+  const last = rested("last", "2026-09-30T09:00:00.000Z")
+  for (const t of [first, middle, last]) t.lastFence = { kind: "done", body: "Finished" } as ThreadView["lastFence"]
+  const threads = [first, middle, last, ask("ask", "2026-09-30T06:00:00.000Z")]
+  for (const sort of ["done", "state"] as const) {
+    const ordered = phoneQueue(threads, "lifo", sort)
+    const index = ordered.findIndex((t) => t.id === "middle")
+    assert.equal(ordered[index + 1]?.id, "first")
+    assert.equal(nextThreadNeedingYou(threads, "middle", "lifo", {}, sort)?.id, "first")
+    assert.equal(nextThreadNeedingYou(threads, ordered.at(-1)!.id, "lifo", {}, sort), undefined)
+  }
+})
