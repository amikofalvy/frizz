diff --git a/packages/web/src/components/QueueSortControls.tsx b/packages/web/src/components/QueueSortControls.tsx
index ba519e16..34d65023 100644
--- a/packages/web/src/components/QueueSortControls.tsx
+++ b/packages/web/src/components/QueueSortControls.tsx
@@ -1,24 +1,37 @@
 import { useSnapshot } from "valtio"
+import { ArrowDown, ArrowUp } from "lucide-react"
 import { prefs } from "../lib/prefs.ts"
-import type { QueueDirection, QueueSort } from "../groups.ts"
+import type { QueueSort } from "../groups.ts"
 
 export function QueueSortControls() {
   const { queueOrder, queueSort } = useSnapshot(prefs)
+  const columns: { key: QueueSort; label: string; description: string }[] = [
+    { key: "state", label: "State", description: "Group matching thread icons" },
+    { key: "done", label: "Suggested done", description: "Put checked completion handoffs first" },
+    { key: "time", label: "Updated", description: "When the worker last rested, not live tool output" },
+  ]
   return (
-    <div data-queue-sort-controls className="flex flex-wrap items-center gap-2 py-2 text-[12px] text-muted">
-      <select aria-label="Sort queue by" value={queueSort} title="Last updated uses the thread’s last rest, not live tool output. State groups matching icons; suggested done puts checked handoffs first."
-        onChange={(e) => { prefs.queueSort = e.target.value as QueueSort }}
-        className="min-h-[36px] min-w-0 rounded-md border border-border bg-panel px-2 py-1.5 text-fg max-[800px]:min-h-[44px]">
-        <option value="time">Last updated</option>
-        <option value="state">Thread state</option>
-        <option value="done">Suggested done first</option>
-      </select>
-      <select aria-label="Queue time order" value={queueOrder}
-        onChange={(e) => { prefs.queueOrder = e.target.value as QueueDirection }}
-        className="min-h-[36px] min-w-0 rounded-md border border-border bg-panel px-2 py-1.5 text-fg max-[800px]:min-h-[44px]">
-        <option value="fifo">Oldest first</option>
-        <option value="lifo">Newest first</option>
-      </select>
+    <div data-queue-sort-controls aria-label="Queue sorting" className="grid grid-cols-[auto_1fr_auto] items-center border-b border-border/50 pl-5 pr-1.5 text-[11px] text-muted max-[800px]:px-4">
+      {columns.map(({ key, label, description }) => {
+        const active = queueSort === key
+        const descending = key === "done" ? queueOrder === "fifo" : queueOrder === "lifo"
+        const Arrow = descending ? ArrowDown : ArrowUp
+        return (
+          <button key={key} data-queue-sort={key} aria-pressed={active}
+            aria-label={`Sort by ${label.toLowerCase()}${active ? `, ${descending ? "descending" : "ascending"}` : ""}`}
+            title={`${description}. Click again to reverse.`}
+            onClick={() => {
+              if (active) prefs.queueOrder = queueOrder === "fifo" ? "lifo" : "fifo"
+              else { prefs.queueSort = key; prefs.queueOrder = "fifo" }
+            }}
+            className={`flex min-h-7 items-baseline gap-0.5 whitespace-nowrap py-1.5 outline-none hover:text-fg focus-visible:ring-1 focus-visible:ring-accent max-[800px]:min-h-11 max-[800px]:py-3.5 ${key === "done" ? "justify-self-center" : key === "time" ? "justify-self-end" : "justify-self-start"} ${active ? "text-fg" : ""}`}>
+            <span data-sort-label>{label}</span>
+            {/* Sans at 11px: the 2px box gap paints a 4.56px label/arrow gap; cap-center residual 0.
+                Baseline + cap units keep the symmetric 1em arrow aligned as type scales. */}
+            <Arrow data-sort-arrow aria-hidden="true" size="1em" className={`self-baseline translate-y-[calc(0.5em_-_0.5cap)] ${active ? "" : "invisible"}`} />
+          </button>
+        )
+      })}
     </div>
   )
 }
