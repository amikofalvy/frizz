+test("queue property sorts keep time as the tie-break and never mutate the input", () => {
+  const fence = { kind: "done", body: "Finished" } as ThreadView["lastFence"]
+  const rows = [
+    thread({ id: "rest", lastAssistantAt: "2026-10-01T00:00:00Z" }),
+    thread({ id: "new-done", lastAssistantAt: "2026-10-03T00:00:00Z", lastFence: fence }),
+    thread({ id: "ask", pendingQuestion: true, lastAssistantAt: "2026-10-04T00:00:00Z" }),
+    thread({ id: "old-done", lastAssistantAt: "2026-10-02T00:00:00Z", lastFence: fence }),
+  ]
+  const ids = (sort: "time" | "done" | "state", direction: "fifo" | "lifo" = "fifo") => orderQueue(rows, direction, sort).map((t) => t.id)
+  assert.deepEqual(ids("time"), ["rest", "old-done", "new-done", "ask"])
+  assert.deepEqual(ids("done"), ["old-done", "new-done", "rest", "ask"])
+  assert.deepEqual(ids("done", "lifo"), ["new-done", "old-done", "ask", "rest"])
+  assert.deepEqual(ids("state"), ["ask", "old-done", "new-done", "rest"])
+  assert.deepEqual(rows.map((t) => t.id), ["rest", "new-done", "ask", "old-done"])
+  // An unanswered question outranks stale completion metadata; it is not suggested done.
+  const question = thread({ id: "question", pendingQuestion: true, lastFence: fence })
+  assert.equal(sessionIndicatorKind(question), "needs-input")
+  assert.equal(orderQueue([question, rows[1]!], "fifo", "done")[0]!.id, "new-done")
+})
