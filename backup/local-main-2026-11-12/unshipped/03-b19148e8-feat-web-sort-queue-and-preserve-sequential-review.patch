+  const config = await new Promise((resolveConfig, reject) => {
+    const timer = setTimeout(() => reject(new Error("Stack failed to announce readiness")), 90_000)
+    stack.once("error", (e) => { clearTimeout(timer); reject(e) })
+    stack.once("exit", (code) => { clearTimeout(timer); reject(new Error(`Stack exited ${code}: ${logs.slice(-2000)}`)) })
+    let stdout = ""
+    stack.stdout.on("data", (b) => {
+      stdout += b
+      for (const line of stdout.split("\n")) {
+        try { const v = JSON.parse(line); if (v.url && v.home) { clearTimeout(timer); resolveConfig(v); return } } catch {}
+      }
+    })
+  })
+  const api = createRpcClient(config.url)
+  const sandbox = resolveSandboxDb(config.home)
+  const { cols, vals } = sessionProjectColumns(sandbox)
