+// Real tailer → board → browser queue review, with simulated workers and real lifecycle RPCs.
+// No provider dispatch and no access to the operator's board. Owns one stack and one headless Chrome.
+// nub scripts/verify-queue-review.mjs --out=/absolute/evidence/directory
+import assert from "node:assert/strict"
+import { spawn, execFile, execFileSync } from "node:child_process"
