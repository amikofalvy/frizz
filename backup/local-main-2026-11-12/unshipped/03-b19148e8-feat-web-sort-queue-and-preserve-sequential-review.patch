diff --git a/packages/web/src/components/QueueNavigation.tsx b/packages/web/src/components/QueueNavigation.tsx
new file mode 100644
index 00000000..f0e43a2f
--- /dev/null
+++ b/packages/web/src/components/QueueNavigation.tsx
@@ -0,0 +1,43 @@
+import { useSnapshot } from "valtio"
+import { createContext, useContext } from "react"
+import { asThreads, useBoard } from "../hooks.ts"
+import { orderQueue, queued } from "../groups.ts"
+import { prefs } from "../lib/prefs.ts"
+import { phoneQueue, leaveFiledThread } from "../lib/mobileTriage.ts"
+import { queueNeighbors } from "../lib/queueNavigation.ts"
+import { useOptimisticallyArchived } from "../lib/optimisticArchive.ts"
+import { useOptimisticallySteered } from "../lib/steering.ts"
+import { scrollToQueueCard } from "../store.ts"
+
+// The desktop owns optimistic exits that may not have reached the board yet. Browse the cards that
+// are actually still present, not the stale board list (especially after a reply or a snooze).
+export const QueueReviewIdsContext = createContext<readonly string[] | null>(null)
+
+// Browsing is deliberately read-only: neither button answers, snoozes nor completes anything.
+// Sans at 12px: the phone's 44px hit areas give 21.28 / 21.82px ink gaps around the count,
+// with identical cap-band centres (dsf 6). Keep the padding and spacing shared across both verbs.
+export function QueueNavigation({ slug, phone = false }: { slug: string; phone?: boolean }) {
+  const board = useBoard()
+  const { queueOrder, queueSort } = useSnapshot(prefs)
+  const renderedIds = useContext(QueueReviewIdsContext)
+  const all = useOptimisticallyArchived(useOptimisticallySteered(asThreads(board?.threads ?? [])))
+  const items = phone ? phoneQueue(all, queueOrder, queueSort).filter(queued)
+    : orderQueue(all.filter(queued), queueOrder, queueSort)
+  const ids = !phone && renderedIds ? renderedIds : items.map((t) => t.id)
+  const { index, previous, next } = queueNeighbors(ids, slug)
+  if (index < 0) return null
+  const navigate = (target: string | undefined) => {
+    if (!target) return
+    if (phone) leaveFiledThread(slug, items.find((t) => t.id === target))
+    else scrollToQueueCard(target)
+  }
+  return (
+    <nav aria-label="Queue review" data-queue-navigation className={`flex items-center gap-3 text-[12px] text-muted ${phone ? "border-b border-border px-3 py-1" : "mt-1"}`}>
+      <button type="button" data-queue-previous disabled={!previous} onClick={() => navigate(previous)}
+        className={`${phone ? "min-h-[44px] px-2" : "py-1"} hover:text-fg disabled:opacity-35`}>Previous</button>
+      <span className="tabular-nums" aria-live="polite">{index + 1} of {ids.length}</span>
+      <button type="button" data-queue-next disabled={!next} onClick={() => navigate(next)}
+        className={`${phone ? "min-h-[44px] px-2" : "py-1"} hover:text-fg disabled:opacity-35`}>Next</button>
+    </nav>
+  )
+}
