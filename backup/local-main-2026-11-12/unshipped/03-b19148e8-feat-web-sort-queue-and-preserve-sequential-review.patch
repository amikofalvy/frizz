+    ["early-rest", false], ["early-ask", false], ["done-first", true],
+    ["done-middle", true], ["done-last", true], ["later-rest", false],
+  ]
+  for (const [i, [slug, done]] of specs.entries()) {
+    const sessionId = `00000000-1111-4000-9000-${String(i).padStart(12, "0")}`
+    const at = new Date(Date.now() - (80 - i * 10) * 60_000).toISOString()
+    const text = `Review ${slug}.\n\n${("The change was exercised in the real runtime. Review the handoff before deciding whether it needs another thread.\n\n").repeat(6)}${done ? "\n```done\n- Verified and landed this change.\n```" : "The worker has rested without claiming completion."}`
+    const record = (type, content) => ({ type, uuid: `${sessionId}-${type}`, timestamp: at, session_id: sessionId, cwd: root,
+      message: type === "assistant" ? { role: type, model: "claude-opus-5", id: `msg_${i}`, type: "message", stop_reason: "end_turn", content: [{ type: "text", text: content }], usage: { input_tokens: 100, output_tokens: 100 } } : { role: type, content } })
+    writeFileSync(join(jsonlDir, `${sessionId}.jsonl`), [record("user", `Review ${slug}`), record("assistant", text)].map(JSON.stringify).join("\n") + "\n")
+    execFileSync("sqlite3", [sandbox.db, `INSERT INTO session (${cols}slug, session_id, thread_name, spawned_at, title, backend, model, effort, permission_mode, rested_at) VALUES (${vals}'${slug}', '${sessionId}', 'frizz-${slug}', '${at}', 'Review ${slug}', 'claude', 'opus', 'medium', 'default', '${at}')`])
+  }
+  const deadline = Date.now() + 30_000
+  while (true) {
+    const board = await api.query("board")
+    if (board.threads.filter((t) => t.needsYou).length === specs.length) break
