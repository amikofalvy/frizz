@@ -0,0 +1,8 @@
+export function queueNeighbors(ids: readonly string[], current: string) {
+  const index = ids.indexOf(current)
+  return {
+    index,
+    previous: index > 0 ? ids[index - 1] : undefined,
+    next: index >= 0 ? ids[index + 1] : undefined,
+  }
+}
