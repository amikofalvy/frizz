 export const DEFAULT_SNOOZE_PRESET: SnoozePreset = "1d"
@@ -183,3 +183,23 @@ export function activitySnoozeRow(t: Pick<ThreadView, "runtime" | "wakesOnItsOwn
 export function activitySnoozed(t: Pick<ThreadView, "bgSnoozed" | "runtime" | "wakesOnItsOwn">): boolean {
   return t.bgSnoozed === true && t.runtime === "turn-idle" && t.wakesOnItsOwn === true
 }
+
+/** The same park, whether its controls live in a desktop menu or a phone sheet. A clock wins when
+ * another tab has armed it while the activity-snooze projection is still catching up. */
+export function threadSnoozeState(thread: ThreadView, nowMs = Date.now()) {
+  const until = futureSnoozedUntil(thread, nowMs)
+  const prompt = thread.snoozePrompt?.trim()
+  const byActivity = !until && activitySnoozed(thread)
+  const description = until
+    ? `${prompt ? "Bumps" : "Snoozed until"} ${formatSnoozeWake(until, nowMs)}`
+    : byActivity ? "Snoozed until activity" : null
+  return { until, prompt, armed: Boolean(until) || byActivity, description, activity: activitySnoozeRow(thread) }
+}
+
+export function parseCustomSnooze(value: string, prompt: string, nowMs = Date.now()) {
+  const parsed = parseLocalSnooze(value, nowMs)
+  if (!parsed.ok) return parsed
+  const text = prompt.trim()
+  if (text.length > SNOOZE_PROMPT_MAX) return { ok: false as const, message: `Prompt is too long (${text.length}/${SNOOZE_PROMPT_MAX})` }
+  return { ...parsed, prompt: text || null }
+}
