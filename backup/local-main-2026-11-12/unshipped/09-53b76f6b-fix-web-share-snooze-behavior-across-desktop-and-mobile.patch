diff --git a/packages/web/src/components/snoozeParity.e2e.test.ts b/packages/web/src/components/snoozeParity.e2e.test.ts
new file mode 100644
index 00000000..86612fc6
--- /dev/null
+++ b/packages/web/src/components/snoozeParity.e2e.test.ts
@@ -0,0 +1,226 @@
+import assert from "node:assert/strict"
+import test from "node:test"
+import { createHash, randomUUID } from "node:crypto"
+import { execFile, execFileSync } from "node:child_process"
+import { promisify } from "node:util"
+import { mkdirSync, writeFileSync } from "node:fs"
+import { join } from "node:path"
+import type { BoardSnapshot, ThreadView } from "@frizz/shared"
+
+// Run with scripts/verify-snooze-parity.mjs: a disposable real server, simulated resting worker,
+// real RPC writes and board pushes. No provider credentials or worker processes are needed.
+const baseUrl = process.env.FRIZZ_SNOOZE_PARITY_E2E_URL
+
+test("desktop and phone snooze controls share timed, activity, clear and failure behavior", {
+  skip: !baseUrl, timeout: 180_000,
+}, async () => {
+  const home = process.env.FRIZZ_SNOOZE_PARITY_HOME!
+  const cwd = process.env.FRIZZ_SNOOZE_PARITY_PROJECT!
+  assert.ok(home && cwd, "only run against the wrapper's disposable stack")
+  const { resolveSandboxDb, sessionProjectColumns } = await import("../../../../scripts/lib/sandbox-db.mjs")
+  const { createRpcClient } = await import("../../../../scripts/lib/rpc-client.mjs")
+  const { launchHeadless } = await import("../../../../scripts/lib/headless-browser.mjs")
+  const api = createRpcClient(`${baseUrl}/`)
+  const sandbox = resolveSandboxDb(home)
+  const { cols, vals } = sessionProjectColumns(sandbox)
+  const slug = "snooze-parity"
+  const sessionId = randomUUID()
+  const at = new Date(Date.now() - 60_000).toISOString()
+  const jsonl = join(home, ".claude/projects", cwd.replace(/[/.]/g, "-"))
+  mkdirSync(jsonl, { recursive: true })
+  writeFileSync(join(jsonl, `${sessionId}.jsonl`), [
+    { type: "user", uuid: randomUUID(), timestamp: at, session_id: sessionId, cwd, message: { role: "user", content: "Verify shared snooze behavior" } },
+    { type: "assistant", uuid: randomUUID(), timestamp: at, session_id: sessionId, cwd, message: { id: "rest", role: "assistant", model: "claude-opus-5", stop_reason: "end_turn", content: [{ type: "text", text: "Ready for the snooze check." }], usage: { input_tokens: 2, output_tokens: 10 } } },
+  ].map((r) => JSON.stringify(r)).join("\n") + "\n")
+  // The test process is the simulated daemon's liveness token. Nothing is detached or left behind.
+  const records = join(sandbox.stateDir, "claude-broker")
+  mkdirSync(records, { recursive: true })
+  writeFileSync(join(records, `${createHash("sha256").update(sessionId).digest("hex").slice(0, 16)}.json`), JSON.stringify({ sessionId, daemonPid: process.pid, socketPath: join(records, "unused.sock") }))
+  execFileSync("sqlite3", [sandbox.db, `INSERT INTO session (${cols}slug,session_id,thread_name,spawned_at,title,backend,claude_runtime,model,effort,permission_mode,rested_at) VALUES (${vals}'${slug}','${sessionId}','frizz-${slug}','${at}','Shared snooze behavior','claude','broker','opus','high','default','${at}')`])
+  const thread = async () => ((await api.query("board")) as BoardSnapshot).threads.find((t) => t.id === slug)!
+  const waitForThread = async (predicate: (t: ThreadView) => boolean) => {
+    const deadline = Date.now() + 20_000
+    while (Date.now() < deadline) {
+      const t = await thread()
+      if (t && predicate(t)) return t
+      await new Promise((r) => setTimeout(r, 100))
+    }
+    assert.fail(`board did not reach expected state: ${JSON.stringify(await thread())}`)
+  }
+  await waitForThread((t) => t.runtime === "turn-idle")
+  const board = await api.query("board") as BoardSnapshot
+  const projectUrl = `${baseUrl}/project/${board.projectSlug}`
+  const goal = async (enabled: boolean) => {
+    await api.mutate("setThreadRecurringPrompt", { slug, sessionId, prompt: enabled ? "Check the queued work" : null, stopHook: false, heartbeat: enabled, postCompaction: false, intervalSeconds: 3600 })
+    await waitForThread((t) => (t.wakesOnItsOwn === true) === enabled)
+  }
+  const browser = await launchHeadless()
+  const page = await browser.newPage()
+  let rejectSnooze = false
+  await page.setRequestInterception(true)
+  page.on("request", (r) => {
+    // adhoc-stack has no launcher/control plane; this is unrelated to the snooze RPCs under test.
+    if (new URL(r.url()).pathname === "/_frizz/control/status") {
+      void r.respond({ status: 200, contentType: "application/json", body: JSON.stringify({ protocol: 1, state: "ready", artifactDigest: "snooze-test", updateRestart: false }) })
+    } else if (rejectSnooze && r.url().includes("/rpc/snoozeAwaitingBackground")) {
+      void r.respond({ status: 409, contentType: "application/json", body: JSON.stringify({ error: "Snooze parity test rejection" }) })
+    } else void r.continue()
+  })
+  const errors: string[] = []
+  page.on("pageerror", (e) => errors.push(String(e)))
+  page.on("console", (m) => {
+    if (m.type() === "error" && !(m.location().url?.includes("/rpc/snoozeAwaitingBackground") && m.text().includes("409 (Conflict)"))) errors.push(`${m.text()} ${m.location().url}`)
+  })
+  const shots = process.env.FRIZZ_SNOOZE_PARITY_SHOTS
+  if (shots) mkdirSync(shots, { recursive: true })
+  try {
+    for (const width of [1280, 390]) {
+      const phone = width <= 700
+      const url = `${projectUrl}/thread/${slug}${phone ? "" : "/full"}`
+      await page.setViewport({ width, height: 900, deviceScaleFactor: 1, isMobile: phone, hasTouch: phone })
+      const open = async () => {
+        if (!phone || page.url() !== url) await page.goto(url, { waitUntil: "networkidle0" })
+        if (phone) {
+          if (await page.$("[data-thread-actions-sheet]")) {
+            await page.keyboard.press("Escape")
+            await page.waitForSelector("[data-thread-actions-sheet]", { hidden: true })
+          }
+          await page.waitForSelector("[data-mobile-thread-more]")
+          await page.click("[data-mobile-thread-more]")
+          await page.waitForFunction(() => {
+            const el = document.querySelector('[data-thread-actions-sheet]')
+            const r = el?.getBoundingClientRect()
+            return r && r.height > 0 && r.top >= 0 && r.bottom <= innerHeight + 0.1
+          })
+          await page.click('[data-thread-action="snooze"]')
+          await page.waitForSelector("[data-thread-actions-snooze]")
+        } else {
+          await page.waitForSelector("[data-snooze-menu]")
+          await page.click("[data-snooze-menu]")
+          await page.waitForSelector("[data-snooze-activity]")
+        }
+      }
+      const activity = phone ? '[data-thread-action="snooze-activity"]' : '[data-snooze-activity]'
+      const clickWake = async () => {
+        if (phone) {
+          await page.click('[data-thread-action="snooze-wake"]')
+          await page.waitForSelector("[data-thread-actions-sheet]", { hidden: true })
+        }
+        else {
+          const item = await page.waitForSelector('::-p-text(Wake now)')
+          await item!.click()
+        }
+      }
+      await goal(false)
+      await open()
+      assert.equal(await page.$eval(activity, (el) => el.closest("[disabled], [aria-disabled=true], [data-disabled]") !== null), true, `${width}: no unending park`)
+      if (phone) assert.equal(await page.$eval("[data-snooze-activity-reason]", (el) => el.textContent), "Nothing can wake it")
+      await goal(true)
+      await open()
+      assert.equal(await page.$eval(activity, (el) => el.closest("[disabled], [aria-disabled=true], [data-disabled]") !== null), false)
+      if (shots) {
+        await page.screenshot({ path: join(shots, `snooze-${width}.png`) })
+        if (phone) {
+          const ink = await page.$eval(activity, (el) => {
+            const label = el.children[1] as HTMLElement
+            const probe = document.createElement("span")
+            probe.style.cssText = "display:inline-block;width:0;height:0;padding:0;margin:0;border:0"
+            label.appendChild(probe)
+            const baseline = probe.getBoundingClientRect().bottom
+            probe.remove()
+            const cs = getComputedStyle(label)
+            const canvas = document.createElement("canvas").getContext("2d")!
+            canvas.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`
