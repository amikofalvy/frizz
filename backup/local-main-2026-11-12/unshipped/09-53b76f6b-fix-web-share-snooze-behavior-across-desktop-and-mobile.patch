@@ -0,0 +1,52 @@
+import { useRef, useState } from "react"
+import type { ThreadView } from "@frizz/shared"
+import { rpc } from "../api/rpc.ts"
+import { showToast } from "../store.ts"
+import { activitySnoozeRow, formatSnoozeWake } from "../lib/snooze.ts"
+
+// The request, pending state and feedback belong to the action. Closing a menu or unwinding a phone
+// sheet's history belongs to its caller; `parked` distinguishes a snooze from Wake now.
+export function useThreadSnooze(thread: ThreadView, onApplied: (parked: boolean) => void) {
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState("")
+  const pending = useRef(false)
+
+  async function run(request: () => Promise<unknown>, message: string, parked: boolean) {
+    if (pending.current) return
+    pending.current = true
+    setBusy(true)
+    setError("")
+    try {
+      await request()
+      showToast(message)
+      onApplied(parked)
+    } catch (err) {
+      const message = err instanceof Error ? err.message : "Snooze failed"
+      setError(message)
+      showToast(message.slice(0, 100))
+    } finally {
+      pending.current = false
+      setBusy(false)
+    }
+  }
+
+  function apply(until: string | null, prompt: string | null = null) {
+    return run(
+      () => rpc.setThreadSnooze({ slug: thread.id, sessionId: thread.sessionId ?? "", until, prompt: until ? prompt : null }),
+      until ? `${prompt ? "Bump scheduled" : "Snoozed"} · ${formatSnoozeWake(until)}` : "Snooze cleared",
+      Boolean(until),
+    )
+  }
+
+  function applyActivity() {
+    const row = activitySnoozeRow(thread)
+    if (!row.enabled) return Promise.resolve()
+    return run(
+      () => rpc.snoozeAwaitingBackground({ slug: thread.id, sessionId: thread.sessionId ?? "" }),
+      "Snoozed until activity",
+      true,
+    )
+  }
+
+  return { busy, error, setError, apply, applyActivity }
+}
