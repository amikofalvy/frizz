+// A bounded real-stack check for the shared desktop/phone snooze controls. Optional screenshots:
+//   nub scripts/verify-snooze-parity.mjs --shots=/absolute/evidence/directory
+import { spawn, execFileSync } from "node:child_process"
+import { mkdtempSync, rmSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { fileURLToPath } from "node:url"
+import { createServer } from "node:net"
+import { once } from "node:events"
+
+const root = fileURLToPath(new URL("../", import.meta.url))
+const project = mkdtempSync(join(tmpdir(), "frizz-snooze-parity-"))
+execFileSync("git", ["init", "-q", project])
+const probe = createServer()
+probe.listen(0, "127.0.0.1")
+await once(probe, "listening")
+const port = probe.address().port
+await new Promise((resolve) => probe.close(resolve))
+const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => !key.startsWith("FRIZZ_")))
+const stack = spawn("nub", ["scripts/adhoc-stack.mjs", `--port=${port}`, `--project=${project}`], {
+  cwd: root, env: { ...env, FRIZZ_RUNTIMES: "path" }, stdio: ["ignore", "pipe", "pipe"],
+})
+const exited = once(stack, "exit")
+let child
+try {
+  const info = await new Promise((resolve, reject) => {
+    let lines = ""
+    const timer = setTimeout(() => reject(new Error("stack did not start within 60s")), 60_000)
+    stack.once("exit", (code) => { clearTimeout(timer); reject(new Error(`stack exited ${code}`)) })
+    stack.stderr.on("data", (data) => process.stderr.write(data))
+    stack.stdout.on("data", (data) => {
+      process.stdout.write(data)
+      lines += data
+      for (;;) {
+        const end = lines.indexOf("\n")
+        if (end < 0) break
+        const line = lines.slice(0, end)
+        lines = lines.slice(end + 1)
+        try {
+          const value = JSON.parse(line)
+          if (value.home && value.url) { clearTimeout(timer); resolve(value) }
+        } catch {}
+      }
+    })
+  })
+  const shots = process.argv.find((arg) => arg.startsWith("--shots="))?.slice(8)
+  child = spawn("nub", ["run", "test", "packages/web/src/components/snoozeParity.e2e.test.ts"], {
+    cwd: root, stdio: "inherit", env: {
+      ...env, FRIZZ_SNOOZE_PARITY_E2E_URL: `http://127.0.0.1:${port}`,
+      FRIZZ_SNOOZE_PARITY_HOME: info.home, FRIZZ_SNOOZE_PARITY_PROJECT: project,
+      ...(shots ? { FRIZZ_SNOOZE_PARITY_SHOTS: shots } : {}),
+    },
+  })
+  const [code] = await once(child, "exit")
+  process.exitCode = code ?? 1
+} finally {
+  if (child && child.exitCode === null && child.signalCode === null) child.kill("SIGTERM")
+  if (stack.exitCode === null && stack.signalCode === null) stack.kill("SIGTERM")
+  await exited
+  rmSync(project, { recursive: true, force: true })
+  console.log("Snooze parity stack stopped; disposable project removed")
+}
