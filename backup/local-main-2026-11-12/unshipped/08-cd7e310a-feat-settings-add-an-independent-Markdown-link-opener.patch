+test("Markdown links have an independent machine opener, saved through the real settings UI", { skip: !baseUrl, timeout: 120_000 }, async () => {
+  const { default: puppeteer } = await import("puppeteer")
+  const browser = await puppeteer.launch({ headless: true, protocolTimeout: 30_000, args: ["--no-sandbox", "--use-mock-keychain"] })
+  try {
+    const page = await browser.newPage()
+    await page.setViewport({ width: 1000, height: 900 })
+    await browser.defaultBrowserContext().overridePermissions(new URL(baseUrl!).origin, ["clipboard-read", "clipboard-write"])
+    const errors: string[] = []
+    page.on("pageerror", (e) => errors.push(String(e)))
+    page.on("console", (m) => { if (m.type() === "error") errors.push(m.text()) })
+    await page.setRequestInterception(true)
+    page.on("request", (r) => {
+      if (new URL(r.url()).pathname === "/_frizz/control/status") {
+        void r.respond({ status: 200, contentType: "application/json", body: JSON.stringify({ protocol: 1, state: "ready", updateRestart: false }) })
+      } else void r.continue()
+    })
+    await page.goto(`${baseUrl}/thread/file-panel-stack`, { waitUntil: "networkidle2" })
+    const link = '[data-local-path$="/first.md"]'
+    await page.waitForSelector(link)
+    const path = realpathSync(await page.$eval(link, (el) => (el as HTMLElement).dataset.localPath!))
+    // Set the general opener to a DIFFERENT choice. No host application is launched by this test.
+    await page.evaluate(async () => {
+      const module = "/src/api/rpc.ts"; const { rpc } = await import(module)
+      await rpc.settingsSet({ ...await rpc.settingsGet(), localFileOpener: "cursor", markdownFileOpener: "frizz" })
+    })
+    await page.reload({ waitUntil: "networkidle2" })
+    await page.waitForSelector(link)
+    await page.click(link)
+    await page.waitForSelector('.frizz-sheet-panel .md-body')
+    await page.keyboard.press("Escape")
+    await page.waitForFunction(() => !document.querySelector('.frizz-sheet-panel'))
+    const settings = 'button[aria-label="Settings"]'
+    await page.click(settings)
+    const select = 'button[aria-label="Markdown link opener"]'
+    await page.waitForSelector(select)
+    assert.equal(await page.$eval(select, (el) => el.textContent?.trim()), "Frizz")
+    await page.click(select)
+    assert.deepEqual(await page.$$eval('[role="menuitemradio"]', (els) => els.map((el) => el.textContent?.trim())), [
+      "Frizz", "System default", "Cursor", "VS Code", "Reveal in Finder", "Copy path",
+    ])
+    const saved = page.waitForResponse((r) => r.url().endsWith("/rpc/settingsSet") && r.request().method() === "POST")
+    await page.$$eval('[role="menuitemradio"]', (els) => (els.find((el) => el.textContent?.trim() === "Copy path") as HTMLElement).click())
+    assert.equal((await (await saved).json()).result.markdownFileOpener, "copy")
+    assert.equal(await page.$eval('button[aria-label="Local file link opener"]', (el) => el.textContent?.trim()), "Cursor")
+    if (shots) {
+      mkdirSync(shots, { recursive: true })
+      for (const width of [1000, 740]) {
+        await page.setViewport({ width, height: 900, deviceScaleFactor: 2 })
+        await page.screenshot({ path: `${shots}/markdown-settings-${width}.png` })
+      }
+      await page.setViewport({ width: 740, height: 900, deviceScaleFactor: 6 })
+      const row = await page.$eval(select, (el) => {
+        const r = el.parentElement!.getBoundingClientRect()
+        return { x: r.x - 8, y: r.y - 8, width: r.width + 16, height: r.height + 16 }
+      })
+      await page.screenshot({ path: `${shots}/markdown-setting-detail.png`, clip: row })
+    }
+    await page.setViewport({ width: 1000, height: 900 })
+    await page.keyboard.press("Escape")
+    await page.waitForFunction(() => !document.querySelector('[role="dialog"][aria-label="Settings"]'))
+    // Reload: the setting is not merely a local draft or an in-memory mirror.
+    await page.reload({ waitUntil: "networkidle2" })
+    await page.waitForSelector(link)
+    const opened = page.waitForResponse((r) => r.url().endsWith("/rpc/openLocalFile"))
+    await page.click(link)
+    assert.deepEqual((await (await opened).json()).result, { action: "copy", path })
+    await page.waitForFunction((path) => navigator.clipboard.readText().then((text) => text === path), {}, path)
+    assert.equal(await page.$('.frizz-sheet-panel .md-body'), null)
+    // The full-screen split viewer must not take priority over an explicit desktop opener.
+    await page.goto(`${baseUrl}/thread/file-panel-stack/full`, { waitUntil: "networkidle2" })
+    await page.waitForSelector(link)
+    const fullOpened = page.waitForResponse((r) => r.url().endsWith("/rpc/openLocalFile"))
+    await page.click(link)
+    assert.equal((await (await fullOpened).json()).result.action, "copy")
+    assert.equal(await page.$('[data-file-viewer-slot]'), null)
+    // Phones keep reading locally, never launching an app on the server's computer.
+    await page.setViewport({ width: 390, height: 844, isMobile: true, hasTouch: true })
+    let externalRequests = 0
+    page.on("request", (r) => { if (r.url().endsWith("/rpc/openLocalFile")) externalRequests++ })
+    await page.click(link)
+    await page.waitForSelector('.frizz-sheet-panel .md-body')
+    assert.equal(externalRequests, 0)
+    assert.deepEqual(errors, [])
+  } finally {
+    await browser.close()
