+test("the Markdown opener defaults to Frizz, persists across projects and resets independently", () => {
+  const box = sandbox()
+  try {
+    const alpha = box.open("alpha")
+    const beta = box.open("beta")
+    alpha.setSetting("settings", { ...defaultSettings(), markdownFileOpener: undefined, localFileOpener: "cursor" })
+    assert.equal(getSettings(beta, box.home).markdownFileOpener, "frizz")
+    for (const markdownFileOpener of ["frizz", "system", "cursor", "vscode", "finder", "copy"] as const) {
+      setSettings(alpha, { ...getSettings(alpha, box.home), markdownFileOpener }, box.home)
+      const seen = getSettings(beta, box.home)
+      assert.equal(seen.markdownFileOpener, markdownFileOpener)
+      assert.equal(seen.localFileOpener, "cursor")
+    }
+    assert.equal(resetSettings(alpha, box.home).markdownFileOpener, "frizz")
+    assert.equal(getSettings(beta, box.home).markdownFileOpener, "frizz")
+    assert.equal(Settings.safeParse({ ...defaultSettings(), markdownFileOpener: "arbitrary command" }).success, false)
+  } finally {
+    box.done()
+  }
+})
