diff --git a/packages/server/src/local-file.test.ts b/packages/server/src/local-file.test.ts
index 10fd8d4b..e0549fca 100644
--- a/packages/server/src/local-file.test.ts
+++ b/packages/server/src/local-file.test.ts
@@ -126,6 +126,37 @@ test("local opener canonicalizes a regular file inside its trusted root and uses
   assert.equal(calls[0].options.windowsHide, true, "a console opener never flashes a window")
 })
 
+test("Markdown defaults to preview, with an independent choice of every desktop file action", async (t) => {
+  const root = realpathSync(mkdtempSync(join(tmpdir(), "frizz-markdown-opener-")))
+  t.after(() => rmSync(root, { recursive: true, force: true }))
+  const file = join(root, "notes.MDX")
+  writeFileSync(file, "# Notes")
+  const calls: SpawnCall[] = []
+  const options = { previewMarkdown: true, spawn: fakeSpawn(calls), platform: "darwin" as const }
+  assert.deepEqual(await openLocalFile(file, "cursor", [root], options), { action: "preview", path: file })
+  assert.equal(calls.length, 0)
+  assert.deepEqual(await openLocalFile(file, "cursor", [root], { ...options, markdownOpener: "copy" }), { action: "copy", path: file })
+  assert.equal(calls.length, 0)
+  for (const [markdownOpener, args] of [
+    ["system", [file]], ["cursor", ["-a", "Cursor", file]],
+    ["vscode", ["-a", "Visual Studio Code", file]], ["finder", ["-R", file]],
+  ] as const) {
+    await openLocalFile(file, "copy", [root], { ...options, markdownOpener })
+    assert.equal(calls.at(-1)!.command, "open")
+    assert.deepEqual(calls.at(-1)!.args, args)
+  }
+  // The reader's explicit Open still leaves Frizz when links default to the reader.
+  await openLocalFile(file, "vscode", [root], { ...options, previewMarkdown: false })
+  assert.deepEqual(calls.at(-1)!.args, ["-a", "Visual Studio Code", file])
+  await openLocalFile(file, "vscode", [root], { ...options, markdownOpener: "copy", forceSystem: true })
+  assert.deepEqual(calls.at(-1)!.args, [file], "the image escape hatch still forces the OS viewer")
+  const code = join(root, "code.ts")
+  writeFileSync(code, "export {}")
+  await openLocalFile(code, "cursor", [root], { ...options, markdownOpener: "copy" })
+  assert.deepEqual(calls.at(-1)!.args, ["-a", "Cursor", code], "other files keep their own setting")
+  await assert.rejects(openLocalFile(file, "copy", [], options), /trusted roots/, "preview still runs the trust gate")
+})
+
