 import { homedir } from "node:os"
 import { dirname, isAbsolute, join, resolve, sep } from "node:path"
-import type { LocalFileOpener } from "@frizz/shared"
+import type { LocalFileOpener, MarkdownFileOpener } from "@frizz/shared"
 import { normalizeLocalPath } from "./local-path.ts"
 
-export type LocalFileOpenResult = { action: "opened"; path: string } | { action: "copy"; path: string }
+export type LocalFileOpenResult = { action: "opened" | "copy" | "preview"; path: string }
 
 /** The slice of a ChildProcess the opener needs: the two events that settle a spawn, and unref. */
 export interface SpawnedOpener {
@@ -252,10 +252,18 @@ export async function openLocalFile(
   rawPath: string,
   opener: LocalFileOpener,
   roots: readonly string[],
-  options: { forceSystem?: boolean; spawn?: LocalFileSpawn } & OpenerCommandOptions = {},
+  options: { forceSystem?: boolean; previewMarkdown?: boolean; markdownOpener?: MarkdownFileOpener; spawn?: LocalFileSpawn } & OpenerCommandOptions = {},
 ): Promise<LocalFileOpenResult> {
   const path = resolveLocalFile(rawPath, roots)
-  const selected = options.forceSystem ? "system" : opener
+  // Decide after the trust gate. The client asks for preview-or-open on a Markdown link, while the
+  // reader's explicit Open action must always leave Frizz (using the general opener if set to Frizz).
+  const markdown = MARKDOWN_FILE_EXT.test(normalizeLocalPath(rawPath))
+  const markdownOpener = options.markdownOpener ?? "frizz"
+  if (!options.forceSystem && markdown && markdownOpener === "frizz" && options.previewMarkdown) {
+    return { action: "preview", path }
+  }
+  const selected = options.forceSystem ? "system"
+    : markdown && markdownOpener !== "frizz" ? markdownOpener : opener
   if (selected === "copy") return { action: "copy", path }
 
   const spec = localFileOpenCommand(path, selected, options)
