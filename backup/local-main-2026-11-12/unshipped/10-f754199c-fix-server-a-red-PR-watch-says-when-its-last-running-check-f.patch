-        ...(checksChanged && terminal
+        ...((checksChanged || ciSettled) && terminal
           ? {
             checks: {
               verdict: terminal,
@@ -3513,6 +3524,7 @@ export function createScheduler(deps: SchedulerDeps): Scheduler {
               skipped: st!.skipped,
               gated: st!.gated,
               gating: st!.gating,
+              ...(terminal === "failing" ? { running: st!.running } : {}),
             },
