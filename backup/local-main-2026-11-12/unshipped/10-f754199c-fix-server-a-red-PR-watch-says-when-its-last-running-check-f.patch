diff --git a/packages/shared/src/github-wake.test.ts b/packages/shared/src/github-wake.test.ts
index eb11dea0..cd9735c6 100644
--- a/packages/shared/src/github-wake.test.ts
+++ b/packages/shared/src/github-wake.test.ts
@@ -316,6 +316,20 @@ test("a wake carrying CI and review activity yields both parts", () => {
   }, "a machine-facing tail must not cost the divider")
 })
 
+test("a red wake's running count costs neither the CI part nor the steer beside it", () => {
+  for (const running of [2, 0]) {
+    const text = prWatchWakeMessage({
+      target: "nubjs/nub#587",
+      checks: { verdict: "failing", passed: 1, failed: 1, failing: ["build"], running },
+      review: formatGithubWakeSteer(single),
+    })
+    assert.match(text, running ? /2 checks still running/ : /Every check has finished\./)
+    assert.deepEqual(parsePrWatchWake(text), { ref: "nubjs/nub#587", kind: "ci", verdict: "failing", failing: ["build"] })
+    const rest = text.split("\n").filter((line) => !parsePrWatchWake(line)).join("\n")
+    assert.deepEqual(parseGithubWakeSteer(rest), single, "the steer still leads what is left once the CI line comes off")
+  }
+})
+
 // The trailer, the review steer and ordinary agent prose are all NOT status lines. A false positive here
 // puts a divider on a message that never said a PR finished, which is worse than the card it replaces.
 test("text with no pr-watch status line parses as none", () => {
diff --git a/packages/shared/src/index.ts b/packages/shared/src/index.ts
index a85bcba3..ceb01d7c 100644
--- a/packages/shared/src/index.ts
+++ b/packages/shared/src/index.ts
@@ -1539,6 +1539,10 @@ export function prWatchWakeMessage(input: {
     /** `gated` only: how many workflows GitHub is holding for an approval, and which. */
     gated?: number
     gating?: string[]
+    /** `failing` only: how many checks were still running. A red verdict is reported at the first red
+     *  job, so without this the worker cannot tell "CI is done and red" from "red so far". Absent on a
+     *  report held across the 2026-10-29 upgrade, which then says neither. */
+    running?: number
   }
   /** What changed about the PR itself — a conflict appearing, a label moving, a reviewer being asked.
    *  ONE LINE for all of them, joined with semicolons, because each is a clause and not a headline: a
@@ -1609,6 +1613,14 @@ export function prWatchWakeMessage(input: {
     if (lines.length) lines.push("")
     lines.push(input.review)
   }
+  // BELOW EVERY PART, never between the CI line and a steer: `PR_WATCH_CI_FAILED` reads the CI line whole,
+  // and `parseGithubWakeSteer` decides on the first line left once the status lines come off.
+  const running = input.checks?.verdict === "failing" ? input.checks.running : undefined
+  if (running !== undefined) {
+    lines.push("", running > 0
+      ? `${running} check${running === 1 ? "" : "s"} still running; this watcher reports again once they have all finished.`
+      : "Every check has finished.")
+  }
   lines.push("", PR_WATCH_ARMED_TRAILER)
   return lines.join("\n")
 }
