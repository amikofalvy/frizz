From f754199c3bd32527a6d51b9d5f3768d4ba31d383 Mon Sep 17 00:00:00 2001
From: Andrew Mikofalvy <5668128+amikofalvy@users.noreply.github.com>
Date: Thu, 29 Oct 2026 09:32:34 -0700
Subject: [PATCH] fix(server): a red PR watch says when its last running check
 finishes

A failing check is reported as soon as it goes red, even while other
checks are still running, and the CI stamp then holds still. When the
remaining checks finished, nothing changed in the stamp, so the watcher
said nothing. A thread parked on the PR waiting for CI to settle sat
there until someone looked (inkeep/agents-private#8162: the last job
finished at 05:40Z, the thread was nudged by hand 54 minutes later).

The cursor now records whether checks were still running under the
stamp, and a red reading whose last running check finishes is reported
once. Red reports also say how many checks are still running, or that
every check has finished. A cursor written before this records a
baseline and stays quiet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../server/src/awaiting-watch.e2e.test.ts     | 45 +++++++++++++++++++
 packages/server/src/scheduler.ts              | 18 ++++++--
 packages/shared/src/github-wake.test.ts       | 14 ++++++
 packages/shared/src/index.ts                  | 12 +++++
 4 files changed, 86 insertions(+), 3 deletions(-)

diff --git a/packages/server/src/awaiting-watch.e2e.test.ts b/packages/server/src/awaiting-watch.e2e.test.ts
index b9c6659a..04b3379f 100644
--- a/packages/server/src/awaiting-watch.e2e.test.ts
+++ b/packages/server/src/awaiting-watch.e2e.test.ts
@@ -466,6 +466,51 @@ test("every distinct failure speaks: a re-run on the same commit, and a second j
   } finally { h.close() }
 })
 
+// RED IS REPORTED EARLY, SO RED MUST ALSO SAY WHEN IT STOPPED MOVING. `failing` wins over `running`, so
+// the first red job speaks while the rest of CI is still going — and the stamp then holds that reading.
+// When the last running job finished, the stamp did not move and nothing was said: inkeep/agents-private#8162
+// (2026-10-29) reported red at 05:22Z with `OK Cloud Pilot / build` still running, that job went green
+// at 05:40:46Z, and the thread parked on "every check has settled" sat silent until a human looked 54
+// minutes later. One report for the settle, never one per job finishing.
+test("a red reading says once when its last running check finishes, and not for each job before that", async () => {
+  const h = await prHarness()
+  try {
+    const red = { status: "COMPLETED", conclusion: "FAILURE", name: "test:shard18", detailsUrl: "https://gh/runs/1/job/1" }
+    h.setChecks([
+      red,
+      { status: "IN_PROGRESS", name: "build", detailsUrl: "https://gh/runs/1/job/2" },
+      { status: "IN_PROGRESS", name: "e2e", detailsUrl: "https://gh/runs/1/job/3" },
+    ])
+    await h.tick()
+    assert.equal(h.delivered.length, 1, "the first red job is reported at once")
+    assert.match(h.delivered[0], /CI FAILED/)
+    assert.match(h.delivered[0], /2 checks still running/, "…and says CI has not finished")
+    h.delivered.length = 0
+
+    h.setChecks([
+      red,
+      { status: "IN_PROGRESS", name: "build", detailsUrl: "https://gh/runs/1/job/2" },
+      { status: "COMPLETED", conclusion: "SUCCESS", name: "e2e", detailsUrl: "https://gh/runs/1/job/3" },
+    ])
+    await h.tick()
+    assert.deepEqual(h.delivered, [], "one job going green while another still runs is not news")
+
+    h.setChecks([
+      red,
+      { status: "COMPLETED", conclusion: "SUCCESS", name: "build", detailsUrl: "https://gh/runs/1/job/2" },
+      { status: "COMPLETED", conclusion: "SUCCESS", name: "e2e", detailsUrl: "https://gh/runs/1/job/3" },
+    ])
+    await h.tick()
+    assert.equal(h.delivered.length, 1, "the last running check finishing is the news a parked worker waits on")
+    assert.match(h.delivered[0], /CI FAILED on [^\n]*test:shard18/)
+    assert.match(h.delivered[0], /Every check has finished/)
+    h.delivered.length = 0
+
+    await h.tick()
+    assert.deepEqual(h.delivered, [], "a settled red reading stays quiet")
+  } finally { h.close() }
+})
+
 test("a SECOND CI failure on a new commit is reported, and a re-poll of the same commit is not", async () => {
   const h = await prHarness()
   try {
